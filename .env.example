# База данных Postgres (Neon / Vercel Postgres даёт эту переменную автоматически)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/olga
# Любая длинная случайная строка
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Первый администратор (создаётся один раз, когда в базе ещё нет пользователей)
ADMIN_EMAIL=rura.alla@bk.ru
ADMIN_PASSWORD=
# Адрес сайта (после подключения домена — поменять)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Хранилище фото/видео на Vercel (Storage → Blob даёт автоматически). Локально можно не задавать.
BLOB_READ_WRITE_TOKEN=
# Необязательно: почта для «Забыли пароль?» (например smtp.mail.ru)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
